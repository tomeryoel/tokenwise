# MomiHelm public web deployment configuration.
# Copy to .env on your server, then run: ./momihelm web-doctor && ./momihelm web-start
#
# Prerequisites:
# - A VPS or cloud VM with Docker and ports 80/443 open to the internet
# - A domain name whose DNS A/AAAA record points at this server (HTTPS mode)
# - Either OpenAI configured below OR enough disk/RAM for the bundled Ollama model

# --- Public site identity ---------------------------------------------------
# Your public hostname without a trailing slash.
MOMIHELM_PUBLIC_DOMAIN=momihelm.example.com
MOMIHELM_PUBLIC_URL=https://momihelm.example.com

# Email used by Caddy for Let's Encrypt certificate requests (HTTPS mode only).
MOMIHELM_ACME_EMAIL=you@example.com

# Use automatic HTTPS through Caddy. Set to false only for IP/HTTP demos.
MOMIHELM_WEB_TLS=true

# Browser authentication. Must be true when MOMIHELM_WEB_TLS=true.
MOMIHELM_COOKIE_SECURE=true

# Must exactly match the browser origin (scheme + host + port if non-default).
MOMIHELM_ALLOWED_ORIGINS=https://momihelm.example.com

MOMIHELM_SESSION_TTL_HOURS=12
MOMIHELM_MAX_PROMPT_CHARS=100000
MOMIHELM_MAX_IMAGE_BASE64_CHARS=7000000

# Internal frontend bind settings. Caddy publishes 80/443; leave these as-is.
MOMIHELM_HOST=127.0.0.1
MOMIHELM_FRONTEND_PORT=5173

# --- Model provider ---------------------------------------------------------
# Option A (recommended for small VPS): OpenAI
# ENABLE_OPENAI_PROVIDER=true
# OPENAI_API_KEY=sk-...
# OPENAI_CHEAP_MODEL=gpt-4o-mini
# OPENAI_BALANCED_MODEL=gpt-4o-mini
# OPENAI_PREMIUM_MODEL=gpt-4o

# Option B (self-hosted): bundled Ollama container (started by ./momihelm web-start)
ENABLE_OPENAI_PROVIDER=false
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_LOCAL_MODEL=llama3.1:latest
OLLAMA_CHEAP_MODEL=llama3.1:latest
OLLAMA_BALANCED_MODEL=llama3.1:latest
OLLAMA_REQUEST_TIMEOUT_SECONDS=120

# Host-side doctor checks are unused in web mode; keep for compatibility.
OLLAMA_HOST_URL=http://localhost:11434

OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_REQUEST_TIMEOUT_SECONDS=60

N8N_VERSION=2.31.5
